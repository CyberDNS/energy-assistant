# config.yaml.example — committed template, safe to share
# Copy this file to config.yaml and fill in your own values.
# config.yaml is gitignored — every developer/deployment has their own copy.
#
# Real secrets (API tokens, passwords) go in secrets.yaml — NOT here.
# See secrets.yaml.example for the list of required secret keys.

# ---------------------------------------------------------------------------
# Backends
# ---------------------------------------------------------------------------

iobroker:
  host: "192.168.x.x"
  port: 8087
  # Only needed if authentication is enabled in the ioBroker simple-api adapter.
  # Put the values in secrets.yaml (iobroker_user / iobroker_password).
  # username: !secret iobroker_user
  # password: !secret iobroker_password

homeassistant:
  # Direct Home Assistant REST API connection (for devices not bridged via ioBroker).
  # Token goes in secrets.yaml as: ha_token: "<long-lived-access-token>"
  url: "https://your-homeassistant-instance.example.com"
  # or: url: "http://192.168.x.x:8123"

# ---------------------------------------------------------------------------
# Python device plugins
# (devices with complex protocols or MILP participation — require custom code)
# ---------------------------------------------------------------------------

tibber_iobroker:
  # Find your home ID under: tibberlink.0.Homes.* in ioBroker
  home_id: "<your-tibber-home-id>"

pvforecast_iobroker:
  plant_id: "pv"
  timezone: "Europe/Berlin"

zendure:
  # Native Zendure plugin — no ioBroker. Talks MQTT to the Zendure cloud
  # (connection: cloud, default) or to backends.mqtt (connection: local).
  # cloud_key = the Zendure app's authorization cloud key (HA integration key).
  # List product/device keys: python scripts/probe_zendure.py
  cloud_key: !secret zendure_cloud_key
  product_key: "<product-key>"
  device_key: "<device-key>"
  capacity_kwh: 8.0
  max_charge_kw: 1.2
  max_discharge_kw: 1.2
  maintenance_charge_w: 300
  # smart_mode: true   # keep limit writes in RAM instead of flash
  # charge_efficiency: 0.95       # per direction; defaults 0.95
  # discharge_efficiency: 0.95
  # efficiency: learned           # plan with the round trip learned from measured
  #                               # cycles once confident (default: configured)

zendure_iobroker:
  # Find hub_id and device_serial: python scripts/probe_iobroker.py zendure
  hub_id: "<hub-id>"
  device_serial: "<device-serial>"
  # Capacity = number of AB2000 packs × 2 kWh. Confirm via the packNum OID.
  capacity_kwh: 8.0
  max_charge_kw: 1.2
  max_discharge_kw: 1.2
  # Charge power (W) applied when SoC drops below 5% (maintenance mode).
  maintenance_charge_w: 300

sma_modbus_iobroker:
  # SMA battery read via Modbus adapter (instance 0).
  # This battery is NOT controllable — the SMA inverter manages it automatically.
  # OID defaults follow the SMA Modbus register map; override if your model differs.
  # oid_power_w: "modbus.0.inputRegisters.30775_PowerAC"  # signed; negative=charging
  # oid_soc: "modbus.0.inputRegisters.30845_BAT_SoC"
  # oid_max_charge_w: "modbus.0.holdingRegisters.40189_WMaxCha"
  # oid_max_discharge_w: "modbus.0.holdingRegisters.40191_WMaxDsch"

sma_em_iobroker:
  # SMA Energy Manager — direct grid meter via ioBroker sma-em adapter.
  # Find the serial under: sma-em.0.<serial> in the ioBroker object tree.
  # serial: "1234567890"

mt175_ha:
  # MT175 smart meter exposed as a Home Assistant sensor.
  # Uncomment to override the default entity ID (sensor.mt175_mt175_p).
  # entity_id: "sensor.mt175_mt175_p"

home_power_iobroker:
  # Real-time home energy sensors from Home Assistant via ioBroker hass adapter.
  # Override only if your HA entity IDs differ from the defaults.
  # oid_household_w: "hass.0.entities.sensor.power_consumption_household.state"
  # oid_overflow_w: "hass.0.entities.sensor.power_production_overflow_pv_only_household.state"
  # oid_cars_w: "hass.0.entities.sensor.power_consumption_cars.state"
  # oid_pv_w: "hass.0.entities.sensor.power_production_pv.state"

# ---------------------------------------------------------------------------
# Tasmota devices on the LAN (type: tasmota)
# Polls http://<host>/cm?cmnd=Status%2010 directly — no cloud, no MQTT broker.
# Open that URL in a browser to see the value names your device reports.
# ---------------------------------------------------------------------------

# (entries for the devices: list below)
#   # Main grid meter via a Tasmota IR reading head (Hichi, bitShake, …).
#   # A profile maps the value names of a known meter script; bundled ones are
#   # in plugins/tasmota/profiles/ (energy, iskra_mt175, iskra_mt631, ebz_dd3, …).
#   - id: main_grid_meter
#     category: grid_meter
#     type: tasmota
#     tariff: grid
#     host: 192.168.x.x                    # IP or hostname of the IR head
#     profile: iskra_mt175                 # or a path to your own profile .yaml
#     # sensor: MT631                      # only to pick one of several meters on one head
#     # password: !secret tasmota_password # web password, if set (user: admin)
#     # poll_interval_s: 2                 # default 2 s for meters, 10 s otherwise
#     # stale_after_s: 30                  # unavailable after this long without a valid reading
#     # fields:                            # override profile fields (relative to the sensor)
#     #   power_w: { path: P, scale: 1000 }  # e.g. script reports kW
#     # invert_sign: true                  # if the script reports export as positive
#
#   # Without a profile: map by hand, paths below StatusSNS
#   - id: heatpump_meter
#     category: meter
#     type: tasmota
#     metered_by: main_grid_meter
#     host: 192.168.x.x
#     fields:
#       power_w: MT631.P                   # net power, import +, export −
#       energy_in_kwh: MT631.E_in
#       energy_out_kwh: MT631.E_out
#       phase_power_w: [MT631.L1, MT631.L2, MT631.L3]
#
#   # Smart plug with standard Tasmota energy monitoring (ENERGY sensor)
#   - id: dishwasher
#     category: consumer
#     type: tasmota
#     host: 192.168.x.x
#     profile: energy

# ---------------------------------------------------------------------------
# Home Assistant Energy dashboard
# ---------------------------------------------------------------------------

# energy_dashboard:
#   # Every "individual device" of the HA Energy dashboard becomes a consumer
#   # with a learned forecast (needs backends.homeassistant).  Entries whose
#   # sensors a configured device already uses are skipped.
#   import_consumers: true
#   # Loads the optimizer plans itself must not also be forecast: EV chargers,
#   # threshold devices, … Matches the energy sensor, the power sensor, the
#   # name shown in HA or the generated device id.
#   exclude:
#     - sensor.chargepoint_energy
#     - "Wallbox"
#   # tariff: household          # default: the default tariff
#   # learning:                  # options for the learned forecasts (or false)
#   #   history_days: 365

# ---------------------------------------------------------------------------
# Optimizer
# ---------------------------------------------------------------------------

milp:
  # Constant household background load when no load forecast is available.
  baseline_load_kw: 0.3
  # Grid feed-in tariff (EUR/kWh). Set to 0.0 if you don't sell back to the grid.
  feed_in_eur_per_kwh: 0.082
  # Planning horizon in hours.
  horizon_hours: 24

# ---------------------------------------------------------------------------
# Controller and server
# ---------------------------------------------------------------------------

controller:
  # How often device states are polled from backends (seconds).
  poll_interval_s: 5
  # How often the control setpoint is sent to devices (seconds).
  control_interval_s: 15
  # How often the MILP plan is re-solved (seconds). 900 = every 15 minutes.
  # Runs are aligned to the optimizer's slot grid; the value is snapped to a
  # whole number of slots (or a divisor of the slot length if shorter).
  plan_interval_s: 900
  # Start each planning run this many seconds before the slot boundary, so the
  # new plan is published by the time the slot starts. Should exceed the
  # optimizer's runtime.
  plan_lead_s: 30
  # Set to true to compute setpoints without sending commands (safe for testing).
  dry_run: false
  # Safety buffer for EV missed-deadline detection: a deadline is only
  # considered reachable if it fits within max_charge_kw × this factor of
  # the remaining time (not the bare mathematical minimum). Without slack,
  # the optimizer can economically defer charging right up to the exact
  # last possible moment, leaving no room for charger ramp-up delay, SoC
  # reporting lag, or the next replanning cycle to react. 1.2 = require 20%
  # more time than the bare minimum before declaring a deadline reachable.
  ev_feasibility_margin: 1.2

server:
  # Port for the built-in web UI and REST API.
  port: 8088
  # Days of measurement / battery-ledger history kept in the SQLite DB.
  # Older rows are purged hourly. The history API serves at most 7 days.
  history_retention_days: 8
  # Optional: token for read-only access from outside Home Assistant ingress
  # (REST GET requests and the MCP endpoint at /mcp). Without it the API has
  # no authentication — fine as long as only ingress can reach it. See README
  # "Remote read-only access". Generate one with: openssl rand -hex 32
  # api_token: !secret energy_assistant_api_token
  # Addresses that keep full access without a token (default: the HA ingress
  # proxy 172.30.32.2 and localhost).
  # trusted_hosts: ["172.30.32.2", "127.0.0.1", "::1"]

# ---------------------------------------------------------------------------
# Devices
#
# One flat list of everything in the house.  Each device has:
#
#   category:      what it is — grid_meter | meter | pv | battery | charger |
#                  thermal_load | switch | consumer | vehicle | sensor
#   type:          the plugin, i.e. how to talk to it (tasmota, modbus,
#                  generic_homeassistant, openwb_mqtt, zendure, …), followed
#                  by the plugin's own settings (host, profile, …)
#   capabilities:  bindings for Home Assistant backed devices, e.g.
#                  power_w: { entity: sensor.… }
#   params:        model parameters of the category (battery capacity, grid
#                  connection limit, rated power, …)
#   metered_by:    the meter the device sits behind.  Builds the metering
#                  tree; its root is the one grid_meter.
#   tariff:        tariff id the device is billed on (default: the default tariff)
#
# The config is checked at startup: unknown categories, params or
# capabilities, missing required ones and broken metered_by chains stop the
# start with a list of what to fix.
# ---------------------------------------------------------------------------

devices:

  # --- Grid connection (Z1) ---
  - id: main_grid_meter
    category: grid_meter
    type: generic_homeassistant
    tariff: export_tariff
    capabilities:
      power_w: { entity: sensor.mt175_mt175_p }       # net: import +, export −
      # Or two entities for the import and export legs:
      # power_w: { import_entity: sensor.grid_import_w, export_entity: sensor.grid_export_w }
    # params:                    # optional grid connection limit (main fuse)
    #   max_import_kw: 24
    #   curtail_order: [home_battery, wallbox]   # curtailed first → last
    #   limit_hysteresis_kw: 1.0                 # release this far below (default 5 %)

  # --- Household meter (Z2), behind the grid meter ---
  - id: household_meter
    category: meter
    type: tibber_local                    # Tibber Pulse Bridge on the LAN
    metered_by: main_grid_meter
    host: 192.168.x.x
    password: !secret tibber_pulse_password
    tariff: household

  # --- Heat pump leg derived from the meter difference (Messkonzept 8) ---
  - id: heatpump_meter
    category: consumer
    type: differential
    tariff: heatpump
    minuend: main_grid_meter
    minuend_field: "extra.import_w"
    subtrahend: household_meter
    min_w: 0.0

  # --- PV inverter (read-only) ---
  - id: pv
    category: pv
    type: generic_homeassistant
    metered_by: household_meter
    capabilities:
      power_w: { entity: sensor.power_production_pv, invert_sign: true }

  # --- Battery (native Modbus TCP) ---
  - id: home_battery
    category: battery
    type: modbus
    metered_by: household_meter
    profile: sma_sunny_boy_storage
    host: 192.168.x.x
    params:
      capacity_kwh: 7.4
      max_charge_kw: 3.0
      max_discharge_kw: 3.0
      min_soc_pct: 10
      # charge_efficiency: 0.95       # per direction; defaults 0.95
      # discharge_efficiency: 0.95
      # efficiency: learned           # plan with the learned round trip (default: configured)
      # purchase_price_eur: 3500      # with cycle_life: wear cost per kWh cycled
      # cycle_life: 6000
      # no_grid_charge: true          # charge from PV surplus only

  # --- EV charger (openWB, MQTT simpleAPI on backends.mqtt) ---
  - id: wallbox
    category: charger
    type: openwb_mqtt
    chargepoint_id: 1
    # root_topic: openWB

  # --- Household baseline learned as a residual ---
  # The household meter minus every consumer that has its own (learned)
  # forecast on the same tariff.  Consumers that read one HA power sensor
  # learn their forecast by default (learning: false turns that off).
  - id: baseline
    category: consumer
    type: generic_consumer
    forecast:
      type: learned
      history_entity: sensor.power_consumption_household
      subtract: [auto]          # plus any further sensors to take off
      fallback:                 # until the first fit
        type: static_profile
        profile:
          weekdays: [{ hour: 0, consumed_kwh: 10.0 }]
          weekends: [{ hour: 0, consumed_kwh: 10.0 }]

  # --- Aquarium cooler: kept between two temperatures (see assets below) ---
  # - id: aquarium_cooler
  #   category: thermal_load
  #   type: threshold_homeassistant
  #   capabilities:
  #     temperature_c: { entity: sensor.aquarium_temperature }
  #     switch: { entity: switch.aquarium_cooler }
  #   params:
  #     rated_power_w: 150


# ── Threshold devices (assets) ────────────────────────────────────────────────
# An on/off device that keeps a measured value between two thresholds
# (aquarium cooler, fridge, AC, water heater, dehumidifier).  The planner
# schedules its runtime in cheap or PV hours.  How fast the value moves is
# learned from Home Assistant's history (the Learning tab shows the model);
# the rates below are used until a model is learned, and with model: fixed.
#
# assets:
#   aquarium_cooler:
#     type: threshold
#     device: aquarium_cooler          # a thermal_load device (see devices above)
#     label: "Aquarium Cooler"
#     bottom_threshold: 18.0
#     top_threshold: 20.5
#     unit: "°C"
#     direction: reduces               # reduces (cooler) | increases (heater)
#     drift_rate_per_h: 0.185          # change per hour while off
#     active_rate_per_h: 0.417         # net change per hour while running
#     min_runtime_h: 0.5
#     min_offtime_h: 0.5
#     model: learned                   # learned (default) | fixed
#     learning:                        # all optional
#       # value_entity / switch_entity default to the device's
#       # temperature_c / switch capability entities.
#       ambient_entity: sensor.living_room_temperature   # learn the pull towards ambient
#       ambient_weather_entity: weather.home             # ambient forecast (else last value held)
#       history_days: 10               # HA keeps state history 10 days by default
#       refit_interval_h: 6
#       # Two-mode devices (AC) name one switch per mode instead of switch_entity:
#       # modes: { cool: switch.ac_cooling, heat: switch.ac_heating }
